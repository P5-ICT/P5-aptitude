# Airtable (server-only — never NEXT_PUBLIC_*)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Microsoft Entra ID (staff login)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Optional: restrict staff domain (default pillar5group.co.za)
STAFF_EMAIL_DOMAIN=pillar5group.co.za
